{
  "name": "rust-blog",
  "version": "1.0.0",
  "description": "A minimal blog application with an admin panel, built with Rust and Axum.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:css": "npx @tailwindcss/cli -i ./static/input.css -o ./static/tailwind.css --watch",
    "build:css": "npx @tailwindcss/cli -i ./static/input.css -o ./static/tailwind.css --minify",
    "dev:js": "esbuild static/js/main.js --bundle --outfile=static/bundle.js --watch",
    "build:js": "esbuild static/js/main.js --bundle --outfile=static/bundle.js --minify",
    "dev": "npm-run-all --parallel dev:*",
    "build": "npm-run-all build:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marceli99/rust-blog.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/marceli99/rust-blog/issues"
  },
  "homepage": "https://github.com/marceli99/rust-blog#readme",
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "autoprefixer": "^10.4.27",
    "esbuild": "^0.28.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.2.2"
  },
  "dependencies": {
    "@swup/preload-plugin": "^3.2.11",
    "swup": "^4.8.3"
  }
}
